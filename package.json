{
  "name": "danmaku-emby",
  "version": "0.1.0",
  "private": true,
  "description": "Emby client with bilibili-style danmaku overlay — cinema-dark glassmorphism macOS app",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:electron": "node electron/build.mjs",
    "preview": "vite preview",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3 -w @danmaku-emby/mpv-render",
    "rebuild:node": "npm rebuild better-sqlite3 @danmaku-emby/mpv-render",
    "electron:dev": "vite build && npm run build:electron && npm run rebuild:electron && electron .",
    "electron:dev:gpu": "DMEMBY_PLAYER_ENGINE=mpv-window npm run electron:dev",
    "electron:dev:single-window": "DMEMBY_PLAYER_ENGINE=single-window npm run electron:dev",
    "electron:dev:l3": "npm run electron:dev:single-window",
    "electron:dev:mpv-window": "npm run electron:dev:gpu",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@danmaku-emby/mpv-render": "file:./native/mpv-render",
    "@tanstack/react-query": "^5.101.0",
    "better-sqlite3": "^11.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.1.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.6",
    "vitest": "^4.1.9"
  }
}
